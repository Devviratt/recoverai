# RecoverAI — Environment Configuration Template
# Copy this file to .env and fill in optional API keys

# Database — SQLite (default, zero-setup)
DATABASE_URL="file:./dev.db"

# Razorpay Test Mode (optional — application runs in Mock Mode without credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI Provider: "gemini" | "mock" (default: "mock")
AI_PROVIDER=mock

# Gemini API Key (optional — deterministic Mock AI Provider used by default)
GEMINI_API_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_MODE=demo

# Payment Provider: "razorpay" | "mock" (default: "mock")
PAYMENT_PROVIDER=mock
